# Nomes das variáveis que o projeto usa, nunca os valores reais.
# Para rodar localmente: copie para .env e preencha. O .env não vai para o Git.
#
# Lista planejada: o código ainda não existe. Ajuste quando a primeira versão nascer.

# Porta em que o servidor sobe. No container, é a que o Caddy alcança.
PORT=8080

# Conexão com o PostgreSQL. Usuário da aplicação, que não é dono das tabelas.
DATABASE_URL=

# Login com Google (Google Cloud Console > Credenciais).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ID da minha conta Google (o campo "sub"). Só ela entra como dono; o resto é convidado.
OWNER_GOOGLE_ID=

# Segredo que assina o cookie de sessão. Texto aleatório e longo.
SESSION_SECRET=

# Chave do Gemini exclusiva deste projeto, separada da do AniDeck.
GEMINI_API_KEY=

# Token que o build do portfólio envia para ler as pílulas publicadas (ver docs/API.md).
PORTFOLIO_API_TOKEN=

# Token do GitHub que dispara o rebuild do portfólio ao publicar ou remover.
GITHUB_REBUILD_TOKEN=
